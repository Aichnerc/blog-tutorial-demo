---
import { getLangFromUrl, useTranslations } from "../i18n/languages.js";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<button class="theme-toggle" aria-label={t('theme.toggle')}>
  <svg aria-hidden="true" width="30px" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
    <path
      class="sun"
      fill-rule="evenodd"
      d="M12 17.5a5.5 5.5 0 1 0 0-11 5.5 5.5 0 0 0 0 11zm0 1.5a7 7 0 1 0 0-14 7 7 0 0 0 0 14zm12-7a.8.8 0 0 1-.8.8h-2.4a.8.8 0 0 1 0-1.6h2.4a.8.8 0 0 1 .8.8zM4 12a.8.8 0 0 1-.8.8H.8a.8.8 0 0 1 0-1.6h2.5a.8.8 0 0 1 .8.8zm16.5-8.5a.8.8 0 0 1 0 1l-1.8 1.8a.8.8 0 0 1-1-1l1.7-1.8a.8.8 0 0 1 1 0zM6.3 17.7a.8.8 0 0 1 0 1l-1.7 1.8a.8.8 0 1 1-1-1l1.7-1.8a.8.8 0 0 1 1 0zM12 0a.8.8 0 0 1 .8.8v2.5a.8.8 0 0 1-1.6 0V.8A.8.8 0 0 1 12 0zm0 20a.8.8 0 0 1 .8.8v2.4a.8.8 0 0 1-1.6 0v-2.4a.8.8 0 0 1 .8-.8zM3.5 3.5a.8.8 0 0 1 1 0l1.8 1.8a.8.8 0 1 1-1 1L3.5 4.6a.8.8 0 0 1 0-1zm14.2 14.2a.8.8 0 0 1 1 0l1.8 1.7a.8.8 0 0 1-1 1l-1.8-1.7a.8.8 0 0 1 0-1z"
    ></path>
    <path
      class="moon"
      fill-rule="evenodd"
      d="M16.5 6A10.5 10.5 0 0 1 4.7 16.4 8.5 8.5 0 1 0 16.4 4.7l.1 1.3zm-1.7-2a9 9 0 0 1 .2 2 9 9 0 0 1-11 8.8 9.4 9.4 0 0 1-.8-.3c-.4 0-.8.3-.7.7a10 10 0 0 0 .3.8 10 10 0 0 0 9.2 6 10 10 0 0 0 4-19.2 9.7 9.7 0 0 0-.9-.3c-.3-.1-.7.3-.6.7a9 9 0 0 1 .3.8z"
    ></path>
  </svg>
</button>

<style>
  .theme-toggle {
    border: 0;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(0, 0, 0, 0.1);
    position: relative;
    overflow: hidden;
  }

  .theme-toggle:hover {
    background: rgba(255, 151, 118, 0.1);
    transform: scale(1.05);
    border-color: rgba(255, 151, 118, 0.3);
  }

  .theme-toggle:active {
    transform: scale(0.95);
  }

  .theme-toggle::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 151, 118, 0.05));
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .theme-toggle:hover::before {
    opacity: 1;
  }

  .theme-toggle svg {
    width: 20px;
    height: 20px;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .sun {
    fill: #0d0950;
    transition: all 0.3s ease;
  }

  .moon {
    fill: transparent;
    transition: all 0.3s ease;
  }

  :global(.dark) .theme-toggle {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.1);
  }

  :global(.dark) .theme-toggle:hover {
    background: rgba(255, 151, 118, 0.1);
    border-color: rgba(255, 151, 118, 0.3);
  }

  :global(.dark) .sun {
    fill: transparent;
  }

  :global(.dark) .moon {
    fill: #fff;
  }

  /* Smooth rotation animation when toggling */
  .theme-toggle svg {
    transform-origin: center;
  }

  :global(.dark) .theme-toggle svg {
    transform: rotate(180deg);
  }

  /* Focus styles for accessibility */
  .theme-toggle:focus-visible {
    outline: 2px solid #ff9776;
    outline-offset: 2px;
  }

  /* Ripple effect on click */
  @keyframes ripple {
    0% {
      transform: scale(0);
      opacity: 0.6;
    }
    100% {
      transform: scale(1);
      opacity: 0;
    }
  }

  .theme-toggle::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(circle, rgba(255, 151, 118, 0.3) 0%, transparent 70%);
    transform: scale(0);
    animation: none;
  }

  .theme-toggle:active::after {
    animation: ripple 0.6s ease-out;
  }
</style>

<script is:inline>
  // Only run theme initialization once
  if (!window.themeInitialized) {
    window.themeInitialized = true;

    const theme = (() => {
      const localStorageTheme = localStorage?.getItem("theme") ?? "";
      if (["dark", "light"].includes(localStorageTheme)) {
        return localStorageTheme;
      }
      if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
        return "dark";
      }
      return "light";
    })();

    if (theme === "light") {
      document.documentElement.classList.remove("dark");
    } else {
      document.documentElement.classList.add("dark");
    }

    window.localStorage.setItem("theme", theme);

    // Define global toggle function
    window.toggleTheme = () => {
      const element = document.documentElement;
      element.classList.toggle("dark");

      const isDark = element.classList.contains("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
    };
  }

  // Always attach event listeners for new buttons
  document.addEventListener('DOMContentLoaded', () => {
    document
      .querySelectorAll(".theme-toggle")
      .forEach(button => {
        // Remove existing listeners to avoid duplicates
        button.removeEventListener("click", window.toggleTheme);
        button.addEventListener("click", window.toggleTheme);
      });
  });
</script>
