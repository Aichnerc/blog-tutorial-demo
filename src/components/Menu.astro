---
import { getLangFromUrl, useTranslations } from "../i18n/languages.js";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<button aria-expanded="false" aria-controls="main-menu" class="menu">
  <span class="menu-icon">
    <span></span>
    <span></span>
    <span></span>
  </span>
  <span class="menu-text">{t('nav.menu')}</span>
</button>

<style>
  .menu {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    position: relative;
  }

  .menu-icon {
    display: flex;
    flex-direction: column;
    width: 18px;
    height: 12px;
    justify-content: space-between;
  }

  .menu-icon span {
    width: 100%;
    height: 2px;
    background: currentColor;
    border-radius: 1px;
    transition: all 0.3s ease;
    transform-origin: center;
  }

  .menu[aria-expanded="true"] .menu-icon span:nth-child(1) {
    transform: rotate(45deg) translate(3px, 3px);
  }

  .menu[aria-expanded="true"] .menu-icon span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }

  .menu[aria-expanded="true"] .menu-icon span:nth-child(3) {
    transform: rotate(-45deg) translate(3px, -3px);
  }

  .menu-text {
    font-size: 0.85rem;
  }

  @media screen and (max-width: 400px) {
    .menu-text {
      display: none;
    }
  }
</style>
